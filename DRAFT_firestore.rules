rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Reusable Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidProfileId(id) {
      return id is string && id.size() >= 1 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidBoundedStringList(arr, maxLen) {
      return arr is list &&
        arr.size() <= maxLen &&
        (arr.size() == 0 || (arr[0] is string && arr[0].size() >= 1 && arr[0].size() <= 64));
    }

    // Validation Blueprint: UserAccount (/users/{userId})
    function isValidUserAccount(data) {
      return data.keys().hasAll([
          'ownerId',
          'email',
          'displayName',
          'familyName',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'email',
          'displayName',
          'familyName',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId == request.auth.uid &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.familyName is string && data.familyName.size() >= 1 && data.familyName.size() <= 80 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: LearnerProfile (/users/{userId}/profiles/{profileId})
    function isValidLearnerProfile(data) {
      return data.keys().hasAll([
          'profileId',
          'ownerId',
          'name',
          'ageMode',
          'ageYears',
          'preferredTrack',
          'dailyGoalTier',
          'dailyMinutesStudied',
          'lastStudyDate',
          'studyHistory',
          'xp',
          'weeklyXp',
          'streakDays',
          'audioSpeed',
          'masteredLetters',
          'completedSurahs',
          'completedScenarios',
          'downloadedPacks',
          'srs',
          'shareOnGlobal',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'profileId',
          'ownerId',
          'name',
          'ageMode',
          'ageYears',
          'preferredTrack',
          'dailyGoalTier',
          'dailyMinutesStudied',
          'lastStudyDate',
          'studyHistory',
          'xp',
          'weeklyXp',
          'streakDays',
          'audioSpeed',
          'masteredLetters',
          'completedSurahs',
          'completedScenarios',
          'downloadedPacks',
          'srs',
          'shareOnGlobal',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId == request.auth.uid &&
        data.profileId is string && data.profileId.size() >= 1 && data.profileId.size() <= 64 && data.profileId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
        data.ageMode is string && data.ageMode.size() <= 16 && data.ageMode in ['kids', 'standard', 'senior'] &&
        data.ageYears is int && data.ageYears >= 3 && data.ageYears <= 100 &&
        data.preferredTrack is string && data.preferredTrack.size() <= 16 && data.preferredTrack in ['quran', 'msa', 'gulf'] &&
        data.dailyGoalTier is string && data.dailyGoalTier.size() <= 16 && data.dailyGoalTier in ['casual', 'consistent', 'intensive'] &&
        data.dailyMinutesStudied is int && data.dailyMinutesStudied >= 0 && data.dailyMinutesStudied <= 1440 &&
        data.lastStudyDate is string && data.lastStudyDate.size() == 10 && data.lastStudyDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.studyHistory is map && data.studyHistory.size() <= 31 &&
        data.xp is int && data.xp >= 0 && data.xp <= 1000000 &&
        data.weeklyXp is int && data.weeklyXp >= 0 && data.weeklyXp <= 100000 &&
        data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 10000 &&
        (data.audioSpeed is int || data.audioSpeed is float) && data.audioSpeed >= 0.5 && data.audioSpeed <= 2.0 &&
        isValidBoundedStringList(data.masteredLetters, 28) &&
        isValidBoundedStringList(data.completedSurahs, 114) &&
        isValidBoundedStringList(data.completedScenarios, 50) &&
        isValidBoundedStringList(data.downloadedPacks, 20) &&
        data.srs is map && data.srs.size() <= 250 &&
        data.shareOnGlobal is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: LeaderboardEntry (/leaderboard_entries/{entryId})
    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll([
          'entryId',
          'ownerId',
          'profileId',
          'displayName',
          'familyLabel',
          'ageMode',
          'preferredTrack',
          'publicWeeklyXp',
          'totalXp',
          'streakDays',
          'masteredLettersCount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'entryId',
          'ownerId',
          'profileId',
          'displayName',
          'familyLabel',
          'ageMode',
          'preferredTrack',
          'publicWeeklyXp',
          'totalXp',
          'streakDays',
          'masteredLettersCount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId == request.auth.uid &&
        data.entryId == (data.ownerId + '_' + data.profileId) &&
        data.entryId is string && data.entryId.size() >= 3 && data.entryId.size() <= 128 && data.entryId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.profileId is string && data.profileId.size() >= 1 && data.profileId.size() <= 64 && data.profileId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
        data.familyLabel is string && data.familyLabel.size() >= 1 && data.familyLabel.size() <= 80 &&
        data.ageMode is string && data.ageMode.size() <= 16 && data.ageMode in ['kids', 'standard', 'senior'] &&
        data.preferredTrack is string && data.preferredTrack.size() <= 16 && data.preferredTrack in ['quran', 'msa', 'gulf'] &&
        data.publicWeeklyXp is int && data.publicWeeklyXp >= -1 && data.publicWeeklyXp <= 100000 &&
        data.totalXp is int && data.totalXp >= 0 && data.totalXp <= 1000000 &&
        data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 10000 &&
        data.masteredLettersCount is int && data.masteredLettersCount >= 0 && data.masteredLettersCount <= 28 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Master Gate Relational Helpers (evaluated AFTER static auth & schema checks)
    function hasParentUserAccount(userId) {
      return (
        exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid
      ) || (
        existsAfter(/databases/$(database)/documents/users/$(userId)) &&
        getAfter(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid
      );
    }

    function hasBackingProfile(ownerId, profileId) {
      return (
        exists(/databases/$(database)/documents/users/$(ownerId)/profiles/$(profileId)) &&
        get(/databases/$(database)/documents/users/$(ownerId)/profiles/$(profileId)).data.ownerId == request.auth.uid
      ) || (
        existsAfter(/databases/$(database)/documents/users/$(ownerId)/profiles/$(profileId)) &&
        getAfter(/databases/$(database)/documents/users/$(ownerId)/profiles/$(profileId)).data.ownerId == request.auth.uid
      );
    }

    // Collection 1: Private User Account (PII Isolated Strictly to Owner)
    match /users/{userId} {
      allow get: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        (resource == null || existing().ownerId == request.auth.uid);

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserAccount(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if (
        isVerifiedUser() &&
        isValidUserAccount(incoming()) &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'email',
            'displayName',
            'familyName',
            'updatedAt'
          ])
        )
      );

      allow delete: if false;

      // Subcollection 2: Family Learner Profiles (Master Gate Enforced)
      match /profiles/{profileId} {
        allow get: if isSignedIn() &&
          isValidId(userId) &&
          isValidProfileId(profileId) &&
          request.auth.uid == userId &&
          (resource == null || existing().ownerId == request.auth.uid) &&
          hasParentUserAccount(userId);

        allow list: if isSignedIn() &&
          request.auth.uid == userId &&
          existing().ownerId == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidProfileId(profileId) &&
          request.auth.uid == userId &&
          isValidLearnerProfile(incoming()) &&
          incoming().profileId == profileId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasParentUserAccount(userId);

        allow update: if (
          isVerifiedUser() &&
          isValidLearnerProfile(incoming()) &&
          isValidId(userId) &&
          isValidProfileId(profileId) &&
          request.auth.uid == userId &&
          existing().ownerId == request.auth.uid &&
          incoming().ownerId == existing().ownerId &&
          incoming().profileId == existing().profileId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            // Action: Sync Progress & Profile Settings
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name',
              'ageMode',
              'ageYears',
              'preferredTrack',
              'dailyGoalTier',
              'dailyMinutesStudied',
              'lastStudyDate',
              'studyHistory',
              'xp',
              'weeklyXp',
              'streakDays',
              'audioSpeed',
              'masteredLetters',
              'completedSurahs',
              'completedScenarios',
              'downloadedPacks',
              'srs',
              'shareOnGlobal',
              'updatedAt'
            ])
          ) &&
          hasParentUserAccount(userId)
        );

        allow delete: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidProfileId(profileId) &&
          request.auth.uid == userId &&
          existing().ownerId == request.auth.uid &&
          hasParentUserAccount(userId);
      }
    }

    // Collection 3: Non-PII Global Leaderboard Entries
    match /leaderboard_entries/{entryId} {
      allow get: if isSignedIn() &&
        isValidId(entryId) &&
        (resource == null || existing().ownerId == request.auth.uid || existing().publicWeeklyXp >= 0);

      allow list: if isSignedIn() &&
        existing().publicWeeklyXp >= 0;

      allow create: if isVerifiedUser() &&
        isValidId(entryId) &&
        isValidLeaderboardEntry(incoming()) &&
        incoming().entryId == entryId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        hasBackingProfile(incoming().ownerId, incoming().profileId);

      allow update: if (
        isVerifiedUser() &&
        isValidLeaderboardEntry(incoming()) &&
        isValidId(entryId) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().profileId == existing().profileId &&
        incoming().entryId == existing().entryId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action: Sync Leaderboard Stats or Toggle Visibility
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'familyLabel',
            'ageMode',
            'preferredTrack',
            'publicWeeklyXp',
            'totalXp',
            'streakDays',
            'masteredLettersCount',
            'updatedAt'
          ])
        ) &&
        hasBackingProfile(incoming().ownerId, incoming().profileId)
      );

      allow delete: if isVerifiedUser() &&
        isValidId(entryId) &&
        existing().ownerId == request.auth.uid;
    }
  }
}
